{
  "name": "jennah-memchat-ts",
  "version": "0.1.0",
  "private": true,
  "description": "A command-line chatbot that remembers you across sessions, with memory kept in Jennah",
  "license": "Apache-2.0",
  "homepage": "https://github.com/nightblue-io/jennah-memchat-ts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nightblue-io/jennah-memchat-ts.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "memchat-ts": "dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "rm -rf build && tsc -p tsconfig.test.json && node --test --test-concurrency=1 --test-force-exit 'build/test/**/*.test.js'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@google/genai": "^2.24.0",
    "jennah-sdk-ts": "^0.64.0"
  },
  "devDependencies": {
    "@bufbuild/protobuf": "^2.15.0",
    "@connectrpc/connect": "^2.2.0",
    "@connectrpc/connect-node": "^2.2.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
